# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
#
# Content-Security-Policy: only this site's own files, plus Cloudflare Web Analytics (its beacon
# script and where it sends the visit). Styles allow 'unsafe-inline' because React writes some
# sizes as `style` attributes; images allow data: for the generated window textures.
# Never add `no-transform` to Cache-Control here: Cloudflare could no longer add the analytics
# beacon to the page.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Built files carry a hash in their name: a new version gets a new name, so they can be kept a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
