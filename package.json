{
  "name": "yeray-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/screenshot.mjs",
    "check:camp": "node scripts/camp-check.mjs",
    "check:windows": "node scripts/windows-check.mjs",
    "check:title": "node scripts/title-check.mjs",
    "fps": "node scripts/fps.mjs",
    "characters": "node scripts/sprites/cutout.mjs",
    "scenes": "node scripts/sprites/scene.mjs",
    "media": "node scripts/media.mjs"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
